import /vendor/etc/init/hw/init.mt5221.usb.rc
import /vendor/etc/init/hw/init.boottime_trace.rc
import /vendor/etc/init/hw/init.mt5221.uart.rc

on early-init
    mount debugfs debugfs /sys/kernel/debug
    chown system graphics /sys/kernel/debug/sync/sw_sync
    chmod 660 /sys/kernel/debug/sync/sw_sync
    # Fix lockedmem limit for bpf createMap
    setrlimit 8 10485760 10485760

    # Shouldn't be necessary, but sdcard won't start without it. http://b/22568628.
    mkdir /mnt 0775 root system

on init
    #Migrate the customization of init.rc to init.${ro.hardware}.rc here.
    mkdir /dev/cpuset/foreground/boost
    copy /dev/cpuset/cpus /dev/cpuset/foreground/boost/cpus
    copy /dev/cpuset/mems /dev/cpuset/foreground/boost/mems


    # usb/other sdcard/iso/samba mount point
    mkdir /mnt/usb 0775 root system
    mkdir /mnt/other_sdcard 0775 root system
    mkdir /mnt/iso 0775 root system
    mkdir /mnt/samba 0775 root system
    
    #tvcertification mount point
    mkdir /mnt/tvcertificate 0755 root system

    # cache/log/temp... mount point
    mkdir /var 0775 system system
    mount tmpfs tmpfs /var mode=0775,gid=1000

    # create /tmp point to /var/tmp
    mkdir /var/tmp 0775 system system
    symlink /var/tmp /tmp

    # create /var/tmp/media for camera/ve/dwin
    #mkdir /var/tmp/media 0775 media media
    mkdir /var/tmp/hwc 0775 system system
    mkdir /var/tmp/providers.media 0775 system sdcard_rw
    #create /var/tmp/camera for camera temp file shot
    mkdir /mnt/tmp        0775 camera camera
    mkdir /mnt/tmp/camera 0775 camera camera

    # DFB use socket mode for 64bit kernel
    mkdir /dev/shm
    mount -t tmpfs tmpfs /dev/shm

    # create tv related symlink
    # for optee ta path: /lib/optee_armtz
    symlink /mnt/vendor/tvservice/glibc /lib
    symlink /vendor/tvcertificate /certificate
    write /proc/sys/vm/watermark_scale_factor 300
    write /proc/sys/vm/min_free_kbytes 12288

on early-init
    mount_all /vendor/etc/fstab.mt5221 --early
    exec_background u:r:mtk_module_init:s0 root system drmrpc  -- /vendor/bin/mtkModuleInit init /vendor/etc/module_list

on fs
    # enable zram
    write /proc/sys/vm/page-cluster 0
    swapon_all /vendor/etc/fstab.mt5221

on post-fs
    # start console service earlier here
    start console

    chown root system /mnt/tvcertificate
    chmod 0770 /mnt/tvcertificate  
   
    # make mik!* able to access TEE version proc
    chown system drmrpc /proc/tz2_mstar/version

    # make tee-supplicant able to access TEE secure storage space directory & ramlog_setup proc
    # use exec_start to ensure teechown is finished before tee service
    exec_start teechown
    chown hsm drmrpc /vendor/tvcertificate
    chmod 771 /vendor/tvcertificate
    chown hsm root /proc/tz2_mstar/ramlog_setup

    # start tee-supplicant service for file based encryption to use keymaster
    write /proc/boottime "[service] start optee service"
    start optee
    write /proc/boottime "[service] start intertaca service"
    start intertaca

on post-fs
        chmod 0777 /vendor/tvcertificate
	chmod 0755 /vendor/tvcertificate/HDCP2
	chmod 0644 /vendor/tvcertificate/HDCP2/hdcp*
	chmod 0644 /vendor/tvcertificate/hdcp_tx_key.bin
	chmod 0666 /sys/class/gpio/gpio9/value
	chmod 0666 /sys/class/gpio/gpio13/value
	chmod 0666 /sys/class/gpio/gpio37/value
	chmod 0666 /sys/class/gpio/gpio36/value
	chmod 0666 /sys/class/gpio/gpio33/value
	chmod 0666 /sys/class/gpio/gpio32/value
	chmod 0666 /sys/class/gpio/gpio12/value

    # enable ksm
    #write /sys/kernel/mm/ksm/pages_to_scan 100
    #write /sys/kernel/mm/ksm/sleep_millisecs 500
    #write /sys/kernel/mm/ksm/run 1

    # for memtrack
    chmod 711 /sys/kernel/debug

    # for utopia process used
    chmod 444 /proc/cmdline

    # for thermal info
    chown root system /proc/mstar_dvfs/temperature
    chmod 0660 /proc/mstar_dvfs/temperature

    # restore security contexts of device nodes here
    restorecon /dev/gflip
    restorecon /dev/ir
    restorecon /dev/msmailbox
    restorecon /dev/system

on late-fs
    mount_all /vendor/etc/fstab.mt5221 --late

on post-fs-data
    #already handled in init.rc
    #mkdir /data/misc/wifi 0770 wifi wifi
    #mkdir /data/misc/wifi/sockets 0770 wifi wifi
    #mkdir /data/misc/dhcp 0770 dhcp dhcp
    #chown dhcp dhcp /data/misc/dhcp
    #mkdir /data/system 0771 system system
    #mkdir /data/system/wpa_supplicant 0770 wifi wifi


    # pppoe.conf/resolv.conf for read-write
    mkdir /data/misc/ppp 0777 system system
    chown system system /sys/power/pm_copy
    chmod 0660 /sys/power/pm_copy

on boot
    # create the coredump file
    write /proc/sys/kernel/core_pattern /var/coredump.%p.gz
    write /proc/sys/net/core/rmem_max 1048576
    write /proc/sys/net/core/wmem_max 1048576
    write /proc/sys/net/core/xfrm_acq_expires 3600
    write /sys/devices/system/cpu/cpu1/online 1
    write /sys/devices/system/cpu/cpu2/online 1
    write /sys/devices/system/cpu/cpu3/online 1

on property:vendor.mstar.mmfixedfreq.start=1
    start mmFixFreq
    setprop vendor.mstar.mmfixedfreq.start 0

service mmFixFreq /vendor/bin/mmFixFreq
    user root
    class main
    disabled
    oneshot
    seclabel u:r:mmFixFreq:s0

# for wake on cast
on property:vendor.mtk.setWopacketPort.start=1
    start setWopacketPort
    setprop vendor.mtk.setWopacketPort.start 0

service setWopacketPort /vendor/bin/mtkWocUtility setWopacketPort
    class main
    user system
    group system wifi
    disabled
    oneshot
    seclabel u:r:mtkWocUtility:s0

on property:vendor.mtk.getWakeupReason.start=1
    start getWakeupReason
    setprop vendor.mtk.getWakeupReason.start 0

service getWakeupReason /vendor/bin/mtkWocUtility getWakeupReason
    class main
    user system
    group system wifi
    disabled
    oneshot
    seclabel u:r:mtkWocUtility:s0

service teechown /vendor/bin/chownRecursive.sh root hsm /vendor/tvcertificate/tee
    user root
    class main
    disabled
    oneshot

# service for optee
service optee /vendor/bin/tee-supplicant
    class main
    user hsm
    group drmrpc
    shutdown critical
    seclabel u:r:tee:s0
    capabilities

on property:sys.boot_completed=1
    write /sys/module/lowmemorykiller/parameters/minfree "8192,10240,18432,21504,24576,30720"

#servie for intertaca
service intertaca /vendor/bin/intertaca
    class main
    user system
    group system
    oneshot
    seclabel u:r:intertaca:s0

# service for resourcemanager
service resourcemanager /vendor/bin/resourcemanager
    class core
    user system
    group system
    seclabel u:r:resourcemanager:s0

# turn on uart console for userbuild
on property:ro.debuggable=0
    # Give writes to anyone for the trace folder on debug builds.
    # The folder is used to store method traces.
    chmod 0773 /data/misc/trace
    start console

service bugreport /system/bin/dumpstate -d -p -B -z \
        -o /data/user_de/0/com.android.shell/files/bugreports/bugreport
    class main
    disabled
    oneshot
    keycodes 253

# skyworth add
service skyworth_sysctl_cmd_service /vendor/bin/sysctl_cmd
	class core
	group drmrpc media_rw wifi

on property:vendor.skyworth.adb.enabled=1
	setprop persist.sys.adb.enabled true
	setprop persist.sys.usb.config "adb"

on property:vendor.skyworth.adb.enabled=0
	setprop persist.sys.adb.enabled false
	setprop persist.sys.usb.config ""

on property:vendor.skyworth.cleardata_uninstall.enabled=1
	setprop persist.sys.cleardata_uninstall.enabled true

on property:vendor.skyworth.forcestop.enabled=1
	setprop persist.sys.forcestop.enabled true

on property:sys.airtel.live=1
	setprop vendor.sys.airtel.live 1

on property:sys.airtel.live=0
	setprop vendor.sys.airtel.live 0
# skyworth add end

on late-fs
   write /sys/block/dm-0/queue/read_ahead_kb 2048
   write /sys/block/dm-1/queue/read_ahead_kb 2048
   write /sys/block/dm-2/queue/read_ahead_kb 2048

on property:sys.boot_completed=1
   chmod 640 /proc/stpbt/bt_fw_version
   write /sys/devices/system/cpu/cpufreq/interactive/target_loads "60:900000:90"
   write /sys/block/dm-0/queue/read_ahead_kb 512
   write /sys/block/dm-1/queue/read_ahead_kb 512
   write /sys/block/dm-2/queue/read_ahead_kb 512
   #write proc/delay_free/cma_delay_free_timeout 1
   #write proc/delay_free/cma_delay_free_size_limite 104857600
   # update cpusets now that boot is complete and we want better load balancing
   write /dev/cpuset/top-app/cpus 0-3
   write /dev/cpuset/foreground/cpus 0-3
   write /dev/cpuset/foreground/boost/cpus 0-3
   write /dev/cpuset/background/cpus 1-2
   write /dev/cpuset/system-background/cpus 0-3

